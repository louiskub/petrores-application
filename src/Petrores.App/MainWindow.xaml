<Window x:Class="Petrores.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Petrores Studio — Well Log Viewer &amp; Conditioner" 
        Height="850" Width="1350"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Window.Resources>
                <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDBDBD"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CFD8DC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1A2530" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="PETRORES" FontWeight="Bold" FontSize="18" Foreground="#4FC3F7" VerticalAlignment="Center"/>
                    <TextBlock Text=" | Log Viewer" FontSize="15" Foreground="#B0BEC5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Folder:" Foreground="#ECEFF1" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtFolderPath" Width="360" Height="30" VerticalContentAlignment="Center" Padding="8,0"
                             Background="#263238" Foreground="White" BorderBrush="#37474F" BorderThickness="1"/>
                    <Button Content="Browse..." Style="{StaticResource SecondaryButton}" Height="30" Margin="8,0,0,0" Click="BtnBrowse_Click"/>
                    <Button x:Name="BtnLoad" Content="Load Wells" Style="{StaticResource ModernButton}" Height="30" Margin="8,0,0,0" Click="BtnLoad_Click"/>
                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnExportCurrent" Content="Save Current Plot (PNG)" Style="{StaticResource SecondaryButton}" Height="30" Margin="0,0,8,0" Click="BtnExportCurrent_Click"/>
                    <Button x:Name="BtnBatchExport" Content="Batch Export All 50 Plots &amp; Report" Style="{StaticResource AccentButton}" Height="30" Click="BtnBatchExport_Click"/>
                </StackPanel>
            </Grid>
        </Border>

                <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="500"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="12,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Loaded Wells" FontWeight="Bold" FontSize="14" Foreground="#263238"/>
                                <TextBlock x:Name="TxtWellCount" Text="0 files" HorizontalAlignment="Right" Foreground="#78909C" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                            <TextBox x:Name="TxtSearchFilter" Height="28" Padding="6,2" VerticalContentAlignment="Center"
                                     BorderBrush="#CFD8DC" TextChanged="TxtSearchFilter_TextChanged"/>
                        </StackPanel>
                    </Border>

                                        <ListBox x:Name="LstWells" Grid.Row="1" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="LstWells_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,8" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{Binding StatusBadgeColor}" CornerRadius="3" Padding="6,2" VerticalAlignment="Top" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#CFD8DC" Cursor="SizeWE"/>

                        <Grid Grid.Column="2" Background="#F8FAFC">
                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtSelectedWellTitle" Text="Select a well from the list to view log plot" 
                                       FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="TxtSelectedWellDetails" Text="LAS details and conditioning metrics will appear here." 
                                       FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Track 4 (Optional):" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B" FontWeight="SemiBold"/>
                            <ComboBox x:Name="CmbTrack4" Width="160" Height="28" VerticalContentAlignment="Center" Margin="0,0,16,0"
                                      SelectionChanged="CmbTrack4_SelectionChanged"/>
                            <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B" FontWeight="SemiBold"/>
                            <Button Content="-" Style="{StaticResource SecondaryButton}" Width="32" Height="28" Padding="0" Click="BtnZoomOut_Click"/>
                            <Button x:Name="BtnResetZoom" Content="100%" Style="{StaticResource SecondaryButton}" Width="52" Height="28" Padding="0" Margin="4,0" Click="BtnResetZoom_Click"/>
                            <Button Content="+" Style="{StaticResource SecondaryButton}" Width="32" Height="28" Padding="0" Click="BtnZoomIn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,6,10,10">
                                        <TabItem Header="  Log Plot (Composite)  " FontSize="13" FontWeight="SemiBold">
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0">
                            <ScrollViewer x:Name="PlotScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="PlotContainer" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
                                    <Image x:Name="ImgPlot" RenderOptions.BitmapScalingMode="HighQuality" Stretch="None"/>
                                    <TextBlock x:Name="TxtNoPlot" Text="No well selected or plot not yet generated." 
                                               Foreground="#94A3B8" FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,150,0,0"/>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                                        <TabItem Header="  Conditioning Report  " FontSize="13" FontWeight="SemiBold">
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="TxtConditioningReport" IsReadOnly="True" BorderThickness="0" 
                                         FontFamily="Consolas" FontSize="12" Foreground="#1E293B"
                                         Background="Transparent" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                                        <TabItem Header="  Curves &amp; Diagnostics  " FontSize="13" FontWeight="SemiBold">
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Curves in Well and Diagnostics" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <ListView x:Name="LvCurves" Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Mnemonic" Width="100" DisplayMemberBinding="{Binding OriginalMnemonic}"/>
                                            <GridViewColumn Header="Standard Measurement" Width="180" DisplayMemberBinding="{Binding MeasurementDisplayName}"/>
                                            <GridViewColumn Header="Original Unit" Width="90" DisplayMemberBinding="{Binding OriginalUnit}"/>
                                            <GridViewColumn Header="Standard Unit" Width="90" DisplayMemberBinding="{Binding ConditionedUnit}"/>
                                            <GridViewColumn Header="Valid Points" Width="90" DisplayMemberBinding="{Binding ValidCount}"/>
                                            <GridViewColumn Header="Null Count" Width="90" DisplayMemberBinding="{Binding NullCount}"/>
                                            <GridViewColumn Header="Missing %" Width="80" DisplayMemberBinding="{Binding NullPercentage, StringFormat={}{0:F1}%}"/>
                                            <GridViewColumn Header="Unit Action" Width="160" DisplayMemberBinding="{Binding UnitConversionStatus}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </TabItem>

                                        <TabItem Header="  LAS Header &amp; Metadata  " FontSize="13" FontWeight="SemiBold">
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Filter Metadata:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#475569"/>
                                    <TextBox x:Name="TxtMetaSearch" Grid.Column="1" Height="28" Padding="6,2" VerticalContentAlignment="Center"
                                             BorderBrush="#CFD8DC" TextChanged="TxtMetaSearch_TextChanged"/>
                                </Grid>

                                                                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                                                                        <TabItem x:Name="TabWellInfo" Header="  Well Info (~W)  " FontSize="12" FontWeight="SemiBold">
                                        <ListView x:Name="LvWellInfo" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,8,0,0">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Mnemonic" Width="110" DisplayMemberBinding="{Binding Mnemonic}"/>
                                                    <GridViewColumn Header="Value" Width="240" DisplayMemberBinding="{Binding Value}"/>
                                                    <GridViewColumn Header="Unit" Width="80" DisplayMemberBinding="{Binding Unit}"/>
                                                    <GridViewColumn Header="Description" Width="300" DisplayMemberBinding="{Binding Description}"/>
                                                    <GridViewColumn Header="Line #" Width="60" DisplayMemberBinding="{Binding LineNumber}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </TabItem>

                                                                        <TabItem x:Name="TabParameters" Header="  Parameters (~P)  " FontSize="12" FontWeight="SemiBold">
                                        <ListView x:Name="LvParameters" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,8,0,0">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Mnemonic" Width="110" DisplayMemberBinding="{Binding Mnemonic}"/>
                                                    <GridViewColumn Header="Value" Width="240" DisplayMemberBinding="{Binding Value}"/>
                                                    <GridViewColumn Header="Unit" Width="80" DisplayMemberBinding="{Binding Unit}"/>
                                                    <GridViewColumn Header="Description" Width="300" DisplayMemberBinding="{Binding Description}"/>
                                                    <GridViewColumn Header="Line #" Width="60" DisplayMemberBinding="{Binding LineNumber}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </TabItem>

                                                                        <TabItem x:Name="TabVersion" Header="  Version (~V)  " FontSize="12" FontWeight="SemiBold">
                                        <ListView x:Name="LvVersionInfo" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,8,0,0">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Mnemonic" Width="110" DisplayMemberBinding="{Binding Mnemonic}"/>
                                                    <GridViewColumn Header="Value" Width="240" DisplayMemberBinding="{Binding Value}"/>
                                                    <GridViewColumn Header="Unit" Width="80" DisplayMemberBinding="{Binding Unit}"/>
                                                    <GridViewColumn Header="Description" Width="300" DisplayMemberBinding="{Binding Description}"/>
                                                    <GridViewColumn Header="Line #" Width="60" DisplayMemberBinding="{Binding LineNumber}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </TabItem>

                                                                        <TabItem x:Name="TabOther" Header="  Remarks / Other (~O)  " FontSize="12" FontWeight="SemiBold">
                                        <Border BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,8,0,0" Background="#F8FAFC" Padding="12">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBox x:Name="TxtOtherInfo" IsReadOnly="True" BorderThickness="0"
                                                         FontFamily="Consolas" FontSize="12" Foreground="#1E293B"
                                                         Background="Transparent" TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

                <Border Grid.Row="2" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Ready. Load LAS files to start." Foreground="#546E7A" FontSize="12"/>
                <ProgressBar x:Name="PbProgress" Grid.Column="1" Width="180" Height="14" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
